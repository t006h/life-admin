# Supabase (required for production — set in Vercel → Settings → Environment Variables)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Optional dev overrides (local only; not required on Vercel)
DEV_USER_ROLE=user
DEV_USER_PLAN=ai_chief_of_staff
DEV_USER_EMAIL=dev@lifeadmin.local
DEV_USER_FULL_NAME=Dev User
DEV_PREFER_CONFIG=false
